# TypeSafe AI (Jev) の API キー。console.typesafe.ai で発行したものを設定してください。
# 未設定の場合、未知の加盟店は「その他」+ 要確認 として取り込まれます。
TYPESAFE_API_KEY=

# Jev のモデル名(通常は変更不要)
TYPESAFE_MODEL=jev-latest

# 自動採用する confidence の閾値(これ未満は「要確認」)
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.85

# Dropbox デスクトップアプリが同期しているローカルフォルダ。
# 設定すると保存成功後に latest/household.xlsx と backup/household_YYYYMMDD_HHMMSS.xlsx をコピーします。
# 未設定(空)の場合は Dropbox バックアップをスキップします。
# 例: DROPBOX_SMART_LEDGER_PATH=C:\Users\xxxxx\Dropbox\SmartLedger
# (引用符で囲まないこと。"..." で囲むと \t などがエスケープとして解釈されます)
DROPBOX_SMART_LEDGER_PATH=

# 正本の世代バックアップを残す数(省略時は 20)
# BACKUP_GENERATIONS=20

# TypeSafe API のベース URL(通常は変更不要)
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Flask のセッション署名キー(省略時は起動ごとにランダム生成。flash メッセージにのみ使用)
# FLASK_SECRET_KEY=

# 正本 Excel の保存先(省略時は data/household.xlsx)
# SMART_LEDGER_EXCEL_PATH=data/household.xlsx

# Web サーバーのポート(省略時は 5000)
SMART_LEDGER_PORT=5000

# Flask のデバッグモード(1 で有効。通常は 0)
FLASK_DEBUG=0
